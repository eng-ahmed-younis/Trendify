<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- ======================================================== -->
    <!-- BeanPostProcessor (Runs before & after init on ALL beans)-->
    <!-- ======================================================== -->
    <bean id="customBeanPostProcessor" class="com.shop.trendy.models.CustomBeanPostProcessor" />

    <!-- ======================================================== -->
    <!-- CASE 1: Standard Bean with Setter Injection              -->
    <!-- ======================================================== -->
    <bean id="manger" class="com.shop.trendy.models.Manger">
        <property name="name" value="Ahmed" />
        <property name="age" value="35" />
    </bean>

    <bean id="assistantManager" class="com.shop.trendy.models.Manger">
        <property name="name" value="Sarah" />
        <property name="age" value="28" />
    </bean>

    <!-- ======================================================== -->
    <!-- BEAN SCOPES: SINGLETON vs PROTOTYPE                      -->
    <!-- ======================================================== -->
    <bean id="singletonBranch" class="com.shop.trendy.models.Branch" scope="singleton">
        <property name="branchName" value="Cairo Main Branch" />
        <property name="city" value="Cairo" />
    </bean>

    <bean id="prototypeBranch" class="com.shop.trendy.models.Branch" scope="prototype">
        <property name="branchName" value="Alexandria Express Branch" />
        <property name="city" value="Alexandria" />
    </bean>

    <!-- ======================================================== -->
    <!-- CASE 2: Constructor Injection                            -->
    <!-- ======================================================== -->
    <bean id="employee1" class="com.shop.trendy.models.Employee">
        <constructor-arg ref="manger" />
    </bean>

    <bean id="employee2" class="com.shop.trendy.models.Employee">
        <constructor-arg ref="assistantManager" />
    </bean>

    <!-- ======================================================== -->
    <!-- CASE 3: Department with Full Lifecycle & Collections      -->
    <!-- ======================================================== -->
    <bean id="department" class="com.shop.trendy.models.Department" 
          init-method="customInit" 
          destroy-method="customDestroy"
          scope="singleton">

        <!-- Simple values / Literals (including branchName) -->
        <property name="departmentName" value="Information Technology" />
        <property name="branchName" value="Nasr City Branch" />
        <property name="budget" value="150000.50" />

        <!-- Reference to another existing Bean -->
        <property name="manager" ref="manger" />
        <property name="branch" ref="singletonBranch" />

        <!-- List of simple values (Strings) -->
        <property name="tasks">
            <list>
                <value>System Maintenance</value>
                <value>Database Migration</value>
                <value>Spring Framework Upgrade</value>
            </list>
        </property>

        <!-- List of Bean References & Inner Bean -->
        <property name="employees">
            <list>
                <ref bean="employee1" />
                <ref bean="employee2" />
                <!-- Inner Bean -->
                <bean class="com.shop.trendy.models.Employee">
                    <constructor-arg>
                        <bean class="com.shop.trendy.models.Manger">
                            <property name="name" value="Temporary Manager" />
                            <property name="age" value="40" />
                        </bean>
                    </constructor-arg>
                </bean>
            </list>
        </property>

        <!-- Set of unique values -->
        <property name="locations">
            <set>
                <value>Cairo</value>
                <value>Alexandria</value>
                <value>Giza</value>
            </set>
        </property>

        <!-- Map of key-value pairs -->
        <property name="contactDetails">
            <map>
                <entry key="email" value="it-dept@trendy.com" />
                <entry key="phone" value="+20123456789" />
                <entry key="supportDesk" value="Room 402" />
            </map>
        </property>

        <!-- Properties (key-value strings) -->
        <property name="configSettings">
            <props>
                <prop key="server.timeout">5000</prop>
                <prop key="max.connections">100</prop>
                <prop key="debug.mode">true</prop>
            </props>
        </property>

    </bean>

    <!-- ======================================================== -->
    <!-- CASE 4: Constructor Injection by Index and Type          -->
    <!-- ======================================================== -->
    <bean id="hrDepartment" class="com.shop.trendy.models.Department" scope="prototype">
        <constructor-arg index="0" type="java.lang.String" value="Human Resources" />
        <constructor-arg index="1" type="double" value="75000.0" />
        <property name="branchName" value="Maadi Branch" />
        <!-- Setting a property explicitly to null -->
        <property name="manager">
            <null />
        </property>
    </bean>

</beans>
